# ============================================================
# Подпись Android — ключи НИКОГДА не попадают в репозиторий.
# Ключ живёт в GitHub Secrets (KEYSTORE_BASE64 + пароли) и в
# локальных бэкапах владельца; см. «Подпись и релизы» в README.
# ============================================================
**/android/.gradle/
**/android/local.properties
**/android/key.properties
*.jks
*.keystore
*.p12

